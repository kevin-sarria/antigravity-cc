# -----------------------------------------------------------------------------
# Antigravity Plugin for Claude Code (agy-cc) - Configuration Template
# -----------------------------------------------------------------------------
# NOTE: DO NOT commit real secrets or API keys to this file.
# Copy this file to `.env` if you need custom local environment overrides.
# -----------------------------------------------------------------------------

# Optional: Path to a custom backend binary (Antigravity CLI `agy` or Gemini CLI).
# The wrapper detects which one it is. By default it looks for the official `agy`
# in PATH and in its install locations (WinGet, %LOCALAPPDATA%\agy\bin, ~/.local/bin).
# AGY_BIN=C:\Users\<username>\AppData\Local\agy\bin\agy.exe
# AGY_BIN=/home/<username>/.local/bin/agy

# Optional: Sub-agent engine selection
#   antigravity (default) -> Google Antigravity CLI (`agy`), works with Google AI Pro
#   gemini                -> legacy Gemini CLI; only Standard/Enterprise accounts since 2026-06-18
#   codex                 -> OpenAI Codex CLI (never falls back to another engine)
# AGY_ENGINE=antigravity

# Optional: Specific model to use (list them with `agy models`)
# AGY_MODEL=

# Optional: Write permissions for delegate/task (review/challenge/test are always read-only)
#   auto_edit (default) -> may read and edit files, but NOT run shell commands
#   yolo                -> also runs shell commands (tests, installs...) without asking. Use with care.
# AGY_APPROVAL_MODE=auto_edit

# Optional: Max time per sub-agent run in milliseconds (default 570000 = 9.5 min,
# just below Claude Code's 10-minute Bash tool limit)
# AGY_TIMEOUT_MS=570000

# Optional: Print the raw backend events to stderr for troubleshooting
# AGY_DEBUG=1

# Optional: Path to custom Codex CLI binary if using Codex engine
# CODEX_BIN=codex

# Optional: Authentication mode ('google' or 'apikey').
# By default the wrapper strips GEMINI_API_KEY / GOOGLE_API_KEY from the sub-agent
# environment so it uses your Google Account (Google AI Pro) session.
# Sign in with /antigravity:login (or `node bin/agy-wrapper.mjs login`).
# AGY_AUTH_MODE=google

# Optional: API Key override (only used when AGY_AUTH_MODE=apikey)
# GEMINI_API_KEY=
# GOOGLE_API_KEY=
