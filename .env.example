# -----------------------------------------------------------------------------
# Antigravity Plugin for Claude Code (agy-cc) - Configuration Template
# -----------------------------------------------------------------------------
# NOTE: DO NOT commit real secrets or API keys to this file.
# Copy this file to `.env` if you need custom local environment overrides.
# -----------------------------------------------------------------------------

# Optional: Path to custom Antigravity or Gemini CLI binary
# Defaults to searching 'agy', then 'gemini' in system PATH
# AGY_BIN=C:\Users\username\AppData\Roaming\npm\gemini.cmd
# AGY_BIN=/usr/local/bin/agy

# Optional: Sub-agent engine selection ('antigravity' or 'codex')
# Defaults to 'antigravity'
# AGY_ENGINE=antigravity

# Optional: Specific model to use (e.g. 'gemini-2.5-pro', 'gemini-2.5-flash')
# AGY_MODEL=gemini-2.5-pro

# Optional: Path to custom Codex CLI binary if using Codex engine
# CODEX_BIN=codex

# Optional: Authentication mode ('google' or 'apikey').
# By default, agy-cc uses your Google Account login (Google AI Pro subscription).
# Set to 'apikey' ONLY if you explicitly want to use a standalone API Key instead of Google login.
# AGY_AUTH_MODE=google

# Optional: API Key override (leave commented to use Google AI Pro account)
# GEMINI_API_KEY=
# GOOGLE_API_KEY=
