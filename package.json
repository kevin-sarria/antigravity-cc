{
  "name": "antigravity-cc",
  "version": "1.5.2",
  "description": "Orchestrates Google Antigravity CLI (agy) and Codex as sub-agents within Claude Code for dual-agent collaboration",
  "type": "module",
  "main": "./bin/agy-wrapper.mjs",
  "bin": {
    "agy-wrapper": "./bin/agy-wrapper.mjs",
    "antigravity-cc": "./bin/agy-wrapper.mjs"
  },
  "scripts": {
    "start": "node bin/agy-wrapper.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:security": "node tests/security-audit.test.mjs",
    "check-security": "node tests/security-audit.test.mjs",
    "bump-version": "node scripts/bump-version.mjs",
    "check-version": "node scripts/bump-version.mjs --check"
  },
  "keywords": [
    "claude-code",
    "antigravity",
    "gemini",
    "codex",
    "multi-agent",
    "sub-agent",
    "ai-pairing",
    "code-review",
    "plugin"
  ],
  "author": "Kevin Sarria",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=18.0.0"
  }
}
